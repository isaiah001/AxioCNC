#!/bin/bash
# AxioCNC Server Launcher
# Uses bundled Node.js

AXIOCNC_DIR="{{INSTALL_DIR}}"
NODE_BIN="${AXIOCNC_DIR}/nodejs/bin/node"
CLI_FILE="${AXIOCNC_DIR}/dist/cli.js"

# Change to installation directory
if ! cd "${AXIOCNC_DIR}"; then
    echo "ERROR: Cannot change to ${AXIOCNC_DIR}" >&2
    exit 1
fi

# Verify Node.js exists
if [ ! -f "${NODE_BIN}" ]; then
    echo "ERROR: Node.js binary not found at ${NODE_BIN}" >&2
    exit 1
fi

# Verify CLI file exists
if [ ! -f "${CLI_FILE}" ]; then
    echo "ERROR: CLI file not found at ${CLI_FILE}" >&2
    exit 1
fi

# Ensure --host 0.0.0.0 and --allow-remote-access are set
ARGS=("$@")
if [[ ! " ${ARGS[@]} " =~ " --host " ]]; then
    ARGS+=("--host" "0.0.0.0")
fi
if [[ ! " ${ARGS[@]} " =~ " --allow-remote-access " ]]; then
    ARGS+=("--allow-remote-access")
fi

# Run the server with bundled Node.js
# Logging is now handled by winston file transport
"${NODE_BIN}" "${CLI_FILE}" "${ARGS[@]}"
EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
    echo "ERROR: Server exited with code ${EXIT_CODE}" >&2
    exit $EXIT_CODE
fi

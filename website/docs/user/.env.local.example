# Aptabase Analytics Key (for local development)
# Copy this file to .env.local and add your key
# .env.local is gitignored and won't be committed

# Aptabase app key (starts with A-)
DOCUSAURUS_APTABASE_APP_KEY=your-aptabase-key-here

# Optional: Aptabase host (defaults to https://us.aptabase.com)
# DOCUSAURUS_APTABASE_HOST=https://us.aptabase.com

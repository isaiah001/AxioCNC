{
  "watch": ["apps/server/src", "apps/shared/src", "apps/server/package.json"],
  "ext": "js,json",
  "ignore": ["node_modules"],
  "exec": "pnpm --filter @axiocnc/shared run build && node --require @babel/register apps/server/src/cli.js --port 8000 -m /widget:https://cncjs.github.io/cncjs-widget-boilerplate/v1/",
  "env": {
    "NODE_ENV": "development"
  }
}
